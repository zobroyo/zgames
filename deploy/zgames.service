[Unit]
Description=Z Games site (Node)
After=network-online.target
Wants=network-online.target
# Never give up restarting, no matter how many times it fails.
StartLimitIntervalSec=0

[Service]
Type=simple
User=zchat
Group=zchat
WorkingDirectory=/srv/zgames
Environment=PORT=8722
Environment=ROOT=/srv/zgames/site
Environment=MIRROR_DIR=/srv/zgames/mirror
Environment=CATALOG=/srv/zgames/site/catalog.json
Environment=SUPABASE_URL=https://dwstivxwyqdogzgxnidm.supabase.co
Environment=OAUTH_CLIENT_ID=6122c80c-02a1-47fb-9a2f-17dba8403fe1
Environment=OAUTH_REDIRECT=https://game.z-chat.men/auth/callback
Environment=NODE_ENV=production
# Session signing secret (generated by install.sh; optional so the app also
# runs without it).
EnvironmentFile=-/srv/zgames/session-secret

# Sandbox: this process runs repository code, so it gets no access to the
# host's files, users, root, or system configuration.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
# The only tree the site may write: served files, mirror cache, catalog, state.
ReadWritePaths=/srv/zgames

ExecStart=/usr/bin/node /srv/zgames/server.mjs
Restart=always
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
